{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": ["worker.ts", "lib/providers/**/*.ts", "lib/mcp/**/*.ts", "lib/openapi/**/*.ts"]
}
