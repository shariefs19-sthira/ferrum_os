# Production D1 backup dumps (wrangler d1 export) - never commit a data dump
backups/

# Next.js static export output + build metadata - regenerated by every
# `pnpm build`/`next build` run (including FLEET_WATCH.ps1's own local
# auto-deploy gate), never a tracked source artifact. Missing until now
# - found because it kept leaving apps/web/out untracked after every
# build, which blocked the auto-deploy's own working-tree-clean check
# on its very next cycle.
apps/web/out/
apps/web/tsconfig.tsbuildinfo

# FLEET_WATCH.ps1 local state files - harness-local, never a tracked
# artifact (would otherwise dirty the working tree and block the
# auto-deploy's own clean-tree pre-check on the very next cycle).
.fleet-watch-state.json
.fleet-deploy-state.json
.fleet-trigger-daemon-log.json
